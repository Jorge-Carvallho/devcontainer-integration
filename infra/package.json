{
  "name": "devcontainer-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "commit": "node scripts/commit.mjs",
    "pr": "node scripts/abrir-pr.mjs",
    "proteger-branch": "node scripts/proteger-branch-principal.mjs",
    "typecheck": "tsc --project config/tsconfig.json --noEmit",
    "lint": "eslint --config config/eslint.config.js .",
    "format": "prettier --config config/prettier.config.json --ignore-path config/prettierignore --write .",
    "prepare": "cd .. && husky .husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "infra/node_modules/.bin/eslint --config infra/config/eslint.config.js --fix",
      "infra/node_modules/.bin/prettier --config infra/config/prettier.config.json --ignore-path infra/config/prettierignore --write"
    ],
    "*.{json,md,yml,yaml}": [
      "infra/node_modules/.bin/prettier --config infra/config/prettier.config.json --ignore-path infra/config/prettierignore --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/node": "^26.1.2",
    "chalk": "^5.4.1",
    "eslint": "^9.22.0",
    "husky": "^9.1.7",
    "inquirer": "^12.4.2",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
