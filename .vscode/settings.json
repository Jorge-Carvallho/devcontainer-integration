{
  // Liga/desliga TODA a infra no Explorer (uma chave só):
  //   true  = oculta infra (DEV padrão — README, .vscode, src/, app/…)
  //   false = mostra tudo
  // Depois: Ctrl+Shift+P → Developer: Reload Window
  "files.exclude": {
    "{**/.cursor,**/.devcontainer,**/.github,**/.husky,**/.gitignore,**/infra,**/.pnpm-store,**/teste-commit,package.json,pnpm-lock.yaml,eslint.config.js,devcontainer-integration.infra.code-workspace}": false,
    "**/node_modules": true
  },
  "search.exclude": {
    "{**/.cursor,**/.devcontainer,**/.github,**/.husky,**/infra,**/.pnpm-store,**/teste-commit}/**": true,
    "**/.gitignore": true,
    "**/eslint.config.js": true,
    "**/node_modules/**": true
  },
  "eslint.options": {
    "overrideConfigFile": "eslint.config.js"
  },
  "prettier.configPath": "infra/config/prettier.config.json",
  "prettier.ignorePath": "infra/config/prettierignore"
}
