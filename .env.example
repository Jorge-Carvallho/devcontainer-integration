# Variaveis da aplicacao (area do dev — raiz do repo)
# Copie para .env e ajuste por projeto:
#   cp .env.example .env
#
# O Dev Container expoe apenas a porta 3001 (frontend) em devcontainer.json.
# Demais portas sao lidas pela aplicacao a partir deste arquivo.

PORT=3001
BACKEND_PORT=5143
DATABASE_PORT=5432
